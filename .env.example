# Ops token (optional fallback for API/metrics Bearer auth)
# Generate: openssl rand -hex 32
PROXY_ADMIN_TOKEN=change-me-to-a-long-random-string

# Web console first admin (created once when DB has no users)
PROXY_WEB_USER=admin
# Required for first bootstrap; min 8 chars
PROXY_WEB_PASSWORD=change-me-web-password

# Optional first docker-login (pull) account — independent of web users.
# Only created when pull_users table is empty and password is set (min 8 chars).
PROXY_PULL_USER=puller
PROXY_PULL_PASSWORD=

# Upstream credentials used BY THE PROXY when talking to registries (registries[].auth).
# Not the same as PROXY_WEB_* (console) or PROXY_PULL_* (client docker login to proxy).
# Docker Hub: username + Access Token (PAT) recommended
DOCKERHUB_USER=
DOCKERHUB_TOKEN=
# GHCR example (if enabled in config.yaml auth):
# GITHUB_USER=
# GITHUB_TOKEN=

# --- 运维 / 网页（必填类）---
# 必须生成随机值；不要保留为空
PROXY_ADMIN_TOKEN=

PROXY_WEB_USER=admin
# 首次空库引导；至少 8 位
PROXY_WEB_PASSWORD=

# --- 客户端拉取鉴权（可选，独立于网页账号）---
PROXY_PULL_USER=puller
PROXY_PULL_PASSWORD=

# --- 上游鉴权：代理访问真实仓库时使用（可选，空=公共匿名）---
# 不是 PROXY_WEB_* / PROXY_PULL_*

# Docker Hub（建议 Access Token）
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# GitHub Container Registry (ghcr.io) — PAT 需 read:packages
GITHUB_USER=
GITHUB_TOKEN=

# Quay.io
QUAY_USER=
QUAY_TOKEN=

# Google Container Registry (gcr.io)
# 常用 username=_json_key，password=服务账号 JSON
GCR_USER=
GCR_TOKEN=

# NVIDIA NGC (nvcr.io) — 用户名多为 $oauthtoken
NVCR_USER=
NVCR_TOKEN=

# Elastic (docker.elastic.co)
ELASTIC_USER=
ELASTIC_TOKEN=

# 可选边缘端口（compose profile edge 默认使用标准 80/443）
# EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443

# Optional Docker network override when 172.30.0.0/29 conflicts with an
# existing VPN/Docker route. Keep proxy/caddy static IPs valid and update
# configs/config.docker.yaml trusted_proxies at the same time.
# PROXY_SUBNET=172.30.0.0/29
# PROXY_GATEWAY=172.30.0.1
# PROXY_IP=172.30.0.2
# PROXY_CADDY_IP=172.30.0.3

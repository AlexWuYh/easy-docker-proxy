# Optional TLS edge in front of the data plane.
#
# Preferred client usage keeps ORIGINAL image names:
#   docker pull nginx:alpine
#   docker pull ghcr.io/owner/app:tag
# Traffic reaches the proxy via registry-mirrors and/or internal DNS — see README.
#
# This file is ONLY for compose profile "edge".
# If you already run Caddy on the host, use deploy/caddy.external.example instead
# and do NOT start --profile edge.
#
# Start bundled edge:
#   docker compose --env-file .env -f deploy/docker-compose.yaml --profile edge up -d
# Host ports default to 8080/8443 (EDGE_HTTP_PORT / EDGE_HTTPS_PORT).
# trusted_proxies in proxy config must include the compose network CIDRs.

# Example: corporate mirror hostname used as registry-mirrors target
# (clients: "registry-mirrors": ["https://reg.example.com"]).
# Replace with your real hostname; must match configs/*.yaml hosts[] / default.
reg.example.com {
	reverse_proxy proxy:5000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

# Optional: separate edge names only if you also list them under registries[].hosts

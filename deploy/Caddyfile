# Optional TLS edge in front of the data plane.
#
# Preferred client usage keeps ORIGINAL image names:
#   docker pull nginx:alpine
#   docker pull ghcr.io/owner/app:tag
# Traffic reaches the proxy via registry-mirrors and/or internal DNS — see README.
#
# This file is NOT required for that path. Use it when you want HTTPS on a
# corporate hostname that reverse-proxies to proxy:5000 (Host preserved).
#
# Start:
#   docker compose -f deploy/docker-compose.yaml --profile edge up -d
#
# trusted_proxies in proxy config must include the compose network CIDRs.

# Example: corporate mirror hostname used as registry-mirrors target
# (clients: "registry-mirrors": ["https://registry.example.com"]).
# Replace example.com and ensure DNS + hosts[] / default match.
registry.example.com {
	reverse_proxy proxy:5000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}


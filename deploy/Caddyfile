# Multi-host registry edge (TLS + reverse proxy).
# Replace example.com with your domain and ensure DNS A/AAAA records point here.
#
# Start edge profile:
#   docker compose -f deploy/docker-compose.yaml --profile edge up -d
#
# trusted_proxies in proxy config should include the Docker network (10.0.0.0/8 etc).

hub.example.com {
	reverse_proxy proxy:5000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		# Large blob streaming
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}


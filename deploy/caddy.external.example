# 已有 Caddy：统一入口反代 easy-docker-proxy 数据面
# 不要同时 compose --profile edge。
#
# 1. 只启动 proxy（宿主机 5000）
# 2. trusted_proxies 含 Caddy 出口（同机 127.0.0.1/32）
# 3. config 中 hosts 含本域名（如 reg.example.com），default: dockerhub
# 4. 客户端：
#    - registry-mirrors: ["https://reg.example.com"]
#    - docker pull reg.example.com/ghcr.io/owner/app:tag

reg.example.com {
	reverse_proxy 127.0.0.1:5000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

# 可选 Stats（先映射 127.0.0.1:5001，并限制来源）
# stats.example.com {
# 	reverse_proxy 127.0.0.1:5001
# }
